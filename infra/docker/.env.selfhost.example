# Copy this file to a private env file and pass it with:
# docker compose --env-file .env.selfhost -f docker-compose.selfhost.yml up -d --build

# Public URL where your browser reaches the app. Use https://your-domain.example
# when exposing through Caddy with a real domain.
PUBLIC_API_BASE_URL=http://localhost:8080
ALLOWED_BROWSER_ORIGINS=http://localhost:8080
AI_LAB_SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# Backend persistence. The default stores SQLite in the core-db Docker volume.
CORE_DATABASE_URL=sqlite:////data/core.db

# Translation and transcription.
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8

# TTS provider. If DUB_PROVIDER_URL is empty, the backend uses mock silent audio.
DUB_PROVIDER_URL=
DUB_PROVIDER_VOICES_URL=https://vbee.vn/api/public/v1/voices
DUB_PROVIDER_VOICES_CACHE_TTL_SECONDS=86400
DUB_PROVIDER_APP_ID=
DUB_PROVIDER_TOKEN=
DUB_PROVIDER_VOICE_CODE=hn_female_ngochuyen_full_48k-fhg
DUB_TTS_CHUNK_BATCH_SIZE=5
DUB_TTS_CHUNK_MAX_ATTEMPTS=3
DUB_TTS_CHUNK_RETRY_DELAY_SECONDS=2

# Optional YouTube connector/publishing settings.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_TOKEN_URI=https://oauth2.googleapis.com/token
YOUTUBE_TAGS=
YOUTUBE_UPLOAD_CHUNK_SIZE=-1
YOUTUBE_UPLOAD_MAX_RETRIES=10

# Optional generic publishing adapters.
FACEBOOK_UPLOAD_URL=
FACEBOOK_ACCESS_TOKEN=
TIKTOK_UPLOAD_URL=
TIKTOK_ACCESS_TOKEN=
